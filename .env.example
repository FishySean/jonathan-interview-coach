# 复制为 .env 并填写（.env 不要提交到 git）

# === 蒸馏 LLM（三选一，pipeline 默认 auto 自动检测）===

# 方案 A：本地 Ollama（推荐，无需翻墙 API）
# brew install ollama && ollama serve && ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b

# 方案 B：OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# 方案 C：Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# pipeline 是否在转录后自动蒸馏（也可在 app 界面控制）
AUTO_DISTILL=true
DISTILL_BACKEND=auto
